            "blendControls": false,
            "download": "https://esa-apex.s3.eu-west-1.amazonaws.com/APEX-example-data/PROJECTS/DelineateAnything/Ukraine-2024.simp.fgb"
          }
        },
        "layerCard": {
          "toggleable": true
        }
      },
