    {
      "id": "la-guette-france",
      "name": "La Guette, France",
      "isActive": false,
      "data": [
        {
          "url": "https://gist.githubusercontent.com/datae8059-afk/0bab39e6b67946093ca1a0d861658cb3/raw/1470469e085cf509d413e73f2d050ce6c3e70bf2/France_laguette_PeatExtent.geojson",
          "format": "geojson",
          "zIndex": 100
        },
        {
          "url": "https://gist.githubusercontent.com/datae8059-afk/cd9a41b2468514515d84171694e282b7/raw/9e507833f248b51b31257e223e5157d4389c13f7/France_laguette_AOIextent.geojson",
          "format": "geojson",
          "zIndex": 100
        }
      ],
      "meta": {
        "description": "**La Guette (France)** is a lowland acidic fen in Sologne, central France (~23–26 ha), monitored by the SNO Tourbières network and an ICOS associated ecosystem station. Affected by drainage infrastructure and peatland drying, the site underwent ecological engineering works in 2014 to reduce water loss. Long-term in-situ observations of water-table depth, discharge, water quality, dissolved organic carbon and greenhouse-gas fluxes (2008–2025) make La Guette a key pilot for assessing peatland hydrological recovery, vegetation change, carbon exchange and aquatic carbon losses using Earth Observation (EO) data and climate reanalysis.\n\n**WWF-France** manages the site and provides all relevant in-situ data.",
        "attribution": {
          "text": "Data attribution not specified"
        },
        "categories": []
