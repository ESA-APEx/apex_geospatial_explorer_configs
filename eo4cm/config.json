    {
      "id": "frasne-france",
      "name": "Frasne, France",
      "isActive": false,
      "data": [
        {
          "url": "https://gist.githubusercontent.com/datae8059-afk/15963cfeb539bca2577e7dc5b1944483/raw/64c443f586b0e6d7e521f7428de4c015a9777982/France_fasne_PeatExtention.geojson",
          "format": "geojson",
          "zIndex": 100
        },
        {
          "url": "https://gist.githubusercontent.com/datae8059-afk/b767df33f50712b06149bcbc3b540a4e/raw/6dc5ec2a0aa58a0fb6259523a47ef41828763f8f/France_frasne_AOIextent.geojson",
          "format": "geojson",
          "zIndex": 100
        }
      ],
      "meta": {
        "description": "**Frasne (France)** is a cool, wet, mid-altitude peatland complex in the Jura Mountains (830 m; ~1,400 mm annual precipitation; 7.5 °C mean annual temperature). Monitored by the SNO Tourbières observatory since 2008, it provides a key test site for assessing peatland hydrology, rewetting, vegetation recovery, surface motion and carbon exchange. Restoration of the Forbonnet bog in 2015–2016 offers an opportunity to evaluate Earth Observation (EO) indicators using long-term in-situ meteorological, water-table and greenhouse-gas flux measurements (2008–2024). These data support EO validation and carbon-balance modelling using Sentinel-1/2, Landsat, thermal observations and climate reanalysis.\n\n**WWF-France** manages the site and provides all relevant in-situ data.",
        "attribution": {
          "text": "Data attribution not specified"
        },
        "categories": []
      },
